# Standalone Rally Tascas — environment template. Copy to .env and fill in.

# --- Database (own Postgres, no dependency on the NEI Platform) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rally

# --- Staff auth: authentik OIDC (backend resource-server validation) ---
# Base URL of the authentik instance, e.g. https://auth.example.org
OIDC_PROVIDER_URL=
# Client ID of the rally OAuth2/OIDC provider (public/PKCE client)
OIDC_CLIENT_ID=
# authentik Application slug (discovery: {OIDC_PROVIDER_URL}/application/o/{slug}/)
OIDC_APPLICATION_SLUG=rally
# authentik group names mapped to rally roles
OIDC_ADMIN_GROUP=admin
OIDC_MANAGER_GROUP=manager-rally
OIDC_STAFF_GROUP=rally-staff
OIDC_GUIDE_GROUP=rally-guide

# --- authentik management API (optional) ---
# When set, admins can search ALL authentik accounts (not only those mirrored
# locally after a first login) to link a real account to a placeholder member.
# API root, e.g. https://auth.example.org/api/v3
AUTHENTIK_API_URL=
# Token of a service account with permission to read users.
AUTHENTIK_API_TOKEN=

# --- Staff auth: authentik OIDC (frontend PKCE login) ---
# Issuer/authority — typically {OIDC_PROVIDER_URL}/application/o/{slug}/
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
# Must match a redirect URI registered on the authentik provider
VITE_OIDC_REDIRECT_URI=http://localhost/rally/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost/rally/

# --- Team auth (rally-minted HS256 tokens; independent of OIDC) ---
TEAM_JWT_SECRET_KEY=change_me_to_a_long_random_secret

# --- CORS: public origin(s) the SPA is served from (comma-separated) ---
BACKEND_CORS_ORIGINS=["http://localhost"]

# --- Self check-in (QR/HMAC check-in flow) ---
# When true, teams can self-check-in at checkpoints via signed tokens.
SELF_CHECKIN_ENABLED=true
# Secret used to sign check-in tokens. Falls back to TEAM_JWT_SECRET_KEY when unset.
CHECKIN_HMAC_SECRET=
# Lifetime of a check-in token in seconds.
CHECKIN_TOKEN_TTL_SECONDS=90

# --- Realtime subsystem (Redis cache + event pub/sub for live scoreboard) ---
# Off by default: the app never touches Redis until this is true.
EVENTS_ENABLED=false
# When true, Redis failures degrade silently instead of surfacing errors.
EVENTS_FAIL_SILENTLY=true
# Move the score recompute off the request path (scoring worker handles it).
# Off by default; only takes effect when EVENTS_ENABLED is also true.
RECOMPUTE_OFF_PATH=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Logging ---
# INFO/DEBUG by default (INFO in prod). LOG_JSON emits one JSON object per
# log line (for Loki/ELK) instead of the human-readable colored format.
LOG_LEVEL=INFO
LOG_JSON=false
# Build identifier (CI should set this to the git sha) — tags logs and Sentry
# events so they can be attributed to the deploy that produced them.
RELEASE=dev

# --- Error tracking (Sentry / GlitchTip — same SDK, self-host just swaps the
# DSN) — optional. Empty DSN disables it entirely; nothing is sent. ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Frontend (Vite inlines these at BUILD time, not runtime — see Dockerfile).
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_RELEASE=dev

# --- Prometheus /metrics endpoint ---
# On by default. MUST be blocked at the reverse proxy in production — this
# flag alone does not restrict access to the endpoint.
METRICS_ENABLED=true

# --- Cloudflare R2 object storage (branding image uploads) — optional ---
# When unset, upload endpoints return 503 and bundled defaults are used.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Prod/staging only (GHCR images; used by deploy/docker-compose.*.yaml) ---
# Image tag to pull. Defaults to "latest" when unset.
IMAGE_TAG=latest
# Host port the bundled staging nginx listens on (staging compose only).
STAGING_PORT=80

# --- Root prod overlay only (compose.override.prod.yml; distinct from deploy/) ---
# Image tag for the root-level prod overlay. Defaults to "latest" when unset.
TAG=latest
# NOTE: compose.override.prod.yml also passes SECRET_KEY to the api container,
# but the app never reads it (auth is driven by TEAM_JWT_SECRET_KEY). Leave it
# unless that overlay stops referencing it.
SECRET_KEY=change_me
