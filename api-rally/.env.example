# Copy to `.env` (git-ignored) before running the smoke stack:
#
#   cp .env.example .env
#   docker compose -f docker-compose.smoke.yml up -d
#
# docker compose auto-loads `.env` from this directory for ${VAR} interpolation
# in docker-compose.smoke.yml. Nothing here is a real secret; generate your own
# throwaway values for local use and never commit the resulting `.env`.

# Web Push (VAPID) application-server keypair — P-256, base64url, no padding.
# Generate a fresh pair:
#   python - <<'PY'
#   import base64
#   from cryptography.hazmat.primitives.asymmetric import ec
#   from cryptography.hazmat.primitives import serialization
#   k = ec.generate_private_key(ec.SECP256R1())
#   b = lambda x: base64.urlsafe_b64encode(x).rstrip(b"=").decode()
#   priv = k.private_numbers().private_value.to_bytes(32, "big")
#   pub = k.public_key().public_bytes(
#       serialization.Encoding.X962,
#       serialization.PublicFormat.UncompressedPoint,
#   )
#   print("VAPID_PRIVATE_KEY=" + b(priv))
#   print("VAPID_PUBLIC_KEY=" + b(pub))
#   PY
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:smoke-tests@example.invalid
