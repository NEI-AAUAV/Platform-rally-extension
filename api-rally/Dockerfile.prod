FROM python:3.12-slim AS requirements-stage

WORKDIR /tmp

# Bundle multiple commands in order to produce fewer layers
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --only-binary :all: pip==24.3.1 \
    && pip install --no-cache-dir --only-binary :all: poetry==2.4.1 poetry-plugin-export==1.9.0

COPY ./pyproject.toml ./poetry.lock* /tmp/

RUN poetry export -f requirements.txt --output requirements.txt --only main \
    && pip install --target=/opt/dependencies --no-compile --no-cache-dir --only-binary :all: -r requirements.txt

# Runtime stage
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /api_rally

# Install system dependencies and uvicorn[standard] for production
# Note: uvicorn is in dev dependencies, so install separately for production runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --only-binary :all: uvicorn[standard]==0.38.0

RUN mkdir static

COPY --from=requirements-stage /opt/dependencies /opt/dependencies
ENV PYTHONPATH="${PYTHONPATH}:/opt/dependencies"

COPY ./app ./app
# alembic tree + config: init_db stamps the DB at head on first boot, and future
# schema changes ship as new revisions applied via `alembic upgrade head`.
COPY ./alembic ./alembic
COPY ./alembic.ini ./alembic.ini

EXPOSE 8003
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8003", "--forwarded-allow-ips", "*"]
